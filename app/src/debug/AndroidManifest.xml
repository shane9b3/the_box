<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only playback harness (docs/design/m2-playback-core.md §3.16). Not in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="app.thebox.debug.PlaybackDebugActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TheBox">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="thebox-debug" android:host="play" />
                <data android:scheme="thebox-debug" android:host="stop" />
            </intent-filter>
        </activity>
        <!-- M3 guide seeding and switches (docs/design/m3-guide.md §5.6; WP-D): thebox-debug://guide?seed=… -->
        <activity
            android:name="app.thebox.debug.GuideDebugReceiver"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TheBox">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="thebox-debug" android:host="guide" />
                <!-- M5 integration (§6.5, WP-E amendment): the M5 harness hosts. -->
                <data android:scheme="thebox-debug" android:host="settings" />
                <data android:scheme="thebox-debug" android:host="wipe" />
                <data android:scheme="thebox-debug" android:host="clock" />
                <data android:scheme="thebox-debug" android:host="update" />
                <data android:scheme="thebox-debug" android:host="phone" />
                <data android:scheme="thebox-debug" android:host="keystore-reset" />
            </intent-filter>
        </activity>
    </application>
</manifest>
