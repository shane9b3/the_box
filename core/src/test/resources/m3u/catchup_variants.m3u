# Fixture: catch-up attributes. Covers M25 (header catch-up defaults), M26 (each mode, catchup-type alias, timeshift, tvg-rec, catchup-time, per-channel correction).
#EXTM3U catchup="append" catchup-source="?utc={utc}&lutc={lutc}" catchup-days="5" catchup-correction="-1.5" tvg-shift="2" url-tvg="http://epg.example.com/guide.xml.gz"
#EXTINF:-1 tvg-id="Def.uk" catchup="default" catchup-source="http://archive.example.com/def/{Y}-{m}-{d}/{H}{M}.ts" catchup-days="7d",Default Mode
http://h.example.com/def.ts
#EXTINF:-1 tvg-id="App.uk" catchup="append" catchup-source="?start={utc}&end={utcend}",Append Mode
http://h.example.com/app.m3u8
#EXTINF:-1 tvg-id="Shift.uk" catchup-type="shift" catchup-days="3",Shift Alias
http://h.example.com/shift.m3u8
