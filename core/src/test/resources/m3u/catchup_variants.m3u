http://flu.example.com/channel/index.m3u8
#EXTINF:-1 tvg-id="Old.uk" timeshift="4",Legacy Timeshift
http://h.example.com/old.ts
#EXTINF:-1 tvg-id="Rec.uk" tvg-rec="2" catchup-time="86400",Tvg Rec
http://h.example.com/rec.ts
