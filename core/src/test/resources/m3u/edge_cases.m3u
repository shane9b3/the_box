# Fixture: edge cases. Covers M5 (70 KB line), M8 (upper-case keys, quotes, bare flag), M15, M16, M17, M20, M21, M22, M27, M28, duplicate names.
#EXTM3U url-logo="http://logos.example.com/img/"
#EXTINF:-1 tvg-ID="Upper.us" Group-Title='Single Quoted' tvg-chno=101.0 tvg-shift="-1,5" catchup,Upper Keys
http://h.example.com/upper.ts
#EXTINF:-1 tvg-id="" tvg-shift="3600" tvg-logo="bbc_one",Empty Id
http://h.example.com/empty.ts
#EXTINF:-1 tvg-id="none" tvg-chno="12a" tvg-shift="99",Junk Id
http://h.example.com/junk.ts
#EXTINF:-1 tvg-id="Huge.us" tvg-logo="data:image/png;base64,",Huge Logo Line
http://h.example.com/huge.ts
#EXTINF:-1 tvg-id="Rel.us",Relative URL
streams/rel.m3u8
#EXTINF:-1,RTMP Stream
rtmp://live.example.com/app/stream
#EXTINF:-1,Multicast
udp://@239.1.1.1:1234
#EXTINF:-1,Local File
file:///storage/emulated/0/x.ts
#EXTINF:-1 type="playlist",Nested
http://h.example.com/nested.m3u
#EXTINF:-1 group-title="Sports",Duplicate Name
http://h.example.com/dup1.ts
#EXTINF:-1 group-title="Movies",Duplicate Name
http://h.example.com/dup2.ts
#EXTINF:-1 tvg-logo="data:image/png;base64,iVBORw0KGgo=" radio="true",Radio One
http://radio.example.com/one.mp3
#EXTINF:-1 parent-code="1234" group-title="Adult",Locked
http://h.example.com/locked.ts
#EXTINF:-1 tvg-name="Name From Tvg",
http://h.example.com/noname.ts
#EXTINF:-1,
http://h.example.com/path/From%20Url.m3u8
