<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==== (NFL hub P3, docs/design/m6-nfl-hub.md §17.3) The few texts the frozen §6.8 set did not have. Kept in their own
         file so the commit-0 strings file stays untouched; the lead may fold them into strings_sports_hub.xml. -->

    <!-- Spoken records and forms ("6-4" is read "6 wins, 4 losses"; "4-5-1" adds ", 1 tie"). Joined with
         sports_hub_desc_join_comma. -->
    <plurals name="sports_hub_desc_wins">
        <item quantity="one">%1$d win</item>
        <item quantity="other">%1$d wins</item>
    </plurals>
    <plurals name="sports_hub_desc_losses">
        <item quantity="one">%1$d loss</item>
        <item quantity="other">%1$d losses</item>
    </plurals>
    <plurals name="sports_hub_desc_ties">
        <item quantity="one">%1$d tie</item>
        <item quantity="other">%1$d ties</item>
    </plurals>

    <!-- Clip player sub-line of an ESPN clip that is not in the shown game's list (§3.3: "Video: ESPN" always).
         %1$s / %2$s = away / home abbreviations. -->
    <string name="sports_hub_clip_espn_sub">%1$s at %2$s · Video: ESPN</string>
    <!-- The same without the game (the clip's game is no longer the panel's). -->
    <string name="sports_hub_clip_espn_only">Video: ESPN</string>
</resources>
